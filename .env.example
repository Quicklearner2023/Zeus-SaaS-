# ==========================================
# Personal SaaS Orchestrator Environment Variables
# ==========================================

# 1. Gemini AI Model API Key (Required for Agent Intelligence)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Netlify API Integration Credentials (Required for Automated Deployment & Build Hooks)
# Get Personal Access Token from: Netlify > User Settings > Applications > Personal Access Tokens
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
# Get Site ID from: Netlify > Site Settings > General > Site Details > API ID
NETLIFY_SITE_ID=your_netlify_site_id
# Optional Netlify Build Hook for triggered deployments
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/your_hook_id

# 3. GitHub Actions & Repository Sync Credentials (Required for CI/CD Pipeline)
# Personal Access Token (PAT) with repo & workflow permissions from GitHub Settings
GITHUB_TOKEN=your_github_personal_access_token
# Target Repository Path (e.g. username/repo-name)
GITHUB_REPO=your_username/your_repo_name

# 4. App Node Environment Mode
NODE_ENV=production
